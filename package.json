{
  "name": "blood-pressure-measurement",
  "version": "2.0.1",
  "description": "血压及B超检测（重构版，支持 Win7 / 32 位 + 64 位）",
  "author": "skzx",
  "main": "./out/main/index.js",
  "private": true,
  "engines": {
    "node": ">=18.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts,.vue --fix",
    "format": "prettier --write .",
    "rebuild:ia32": "node scripts/rebuild-native.cjs ia32",
    "rebuild:x64": "node scripts/rebuild-native.cjs x64",
    "build:win": "npm run build && npm run rebuild:x64 && electron-builder --win --x64 --config.publish.channel=win-x64 && npm run rebuild:ia32 && electron-builder --win --ia32 --config.publish.channel=win-ia32",
    "build:win32": "npm run build && npm run rebuild:ia32 && electron-builder --win --ia32 --config.publish.channel=win-ia32",
    "build:win64": "npm run build && npm run rebuild:x64 && electron-builder --win --x64 --config.publish.channel=win-x64",
    "release:win64": "npm run build:win64 -- --publish always",
    "release:win32": "npm run build:win32 -- --publish always",
    "build:unpack": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.7",
    "better-sqlite3": "9.6.0",
    "crypto-js": "^4.2.0",
    "docx-preview": "^0.3.3",
    "docxtemplater": "^3.55.6",
    "docxtemplater-image-module-free": "^1.1.1",
    "electron-log": "^5.2.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.1.7",
    "element-plus": "^2.8.0",
    "fs-extra": "^11.2.0",
    "html2canvas": "^1.4.1",
    "image-size": "^1.1.1",
    "pinia": "^2.2.4",
    "pizzip": "^3.1.7",
    "serialport": "12.0.0",
    "vue-router": "^4.4.5"
  },
  "pnpm": {
    "overrides": {
      "@electron/node-gyp": "10.2.0-electron.2"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "better-sqlite3",
      "electron",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^1.0.2",
    "@electron-toolkit/eslint-config-ts": "^2.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/rebuild": "^3.6.0",
    "@rushstack/eslint-patch": "^1.10.3",
    "@swc/core": "^1.7.26",
    "@types/better-sqlite3": "^7.6.11",
    "@types/crypto-js": "^4.2.2",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.14.8",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "autoprefixer": "^10.4.20",
    "electron": "22.3.27",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.26.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.2",
    "sass": "^1.77.6",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.5.2",
    "unplugin-auto-import": "^0.18.3",
    "unplugin-vue-components": "^0.27.4",
    "vite": "^5.3.1",
    "vue": "^3.4.30",
    "vue-tsc": "^2.0.22"
  }
}
