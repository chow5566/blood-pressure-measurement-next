[VGA2USB.Dev.Intf.AddReg]
HKR,,CLSID,,%KsProxy.CLSID%
HKR,,FriendlyName,,%VGA2USB.DeviceDesc%
HKR,PageAliases,"{71F96464-78F3-11d0-A18C-00A0C9118956}",1,21,E8,C2,3D,13,47,d2,11,0xba,0x41,0x0,0xa0,0xc9,0xd,0x2b,0x5
