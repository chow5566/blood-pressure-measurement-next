; Never be the default device
HKR,"EP\\0", %PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,"EP\\0", %PKEY_AudioDevice_NeverSetAsDefaultEndpoint%,0x00010001,0x00000305
;; 0x00000305 FLOW_MASK_RENDER  | FLOW_MASK_CAPTURE | ROLE_MASK_CONSOLE | ROLE_MASK_COMMUNICATION

[VGA2USB.Dev.Intf.AddReg.48k]
; Set default format to 48kHz, 16-bit, Stereo
